+/**
+ * 三种 usage 形状都认（2026-11-01 晚补）：
+ *  - OpenAI：`prompt_tokens / completion_tokens / prompt_tokens_details.cached_tokens`
+ *  - Gemini 原生：`usageMetadata.promptTokenCount / candidatesTokenCount /
+ *    cachedContentTokenCount` —— Gemini 原生直连走的就是这种，第一版只认 OpenAI
+ *    形状，那条线的轮次读出来全是 0，被存档层当「没数据」清掉了
+ *  - Claude：`input_tokens / output_tokens / cache_read_input_tokens`
+ * 读不出来的字段按 0 算，in/out 双 0 交给调用方当「没有」处理。
+ */
+function normUsageTokens(usage) {
+  if (!usage || typeof usage !== "object") return null;
+  const n = (v) => {
+    const x = Number(v);
+    return Number.isFinite(x) && x > 0 ? x : 0;
+  };
+  let inTok = n(usage.prompt_tokens) || n(usage.promptTokenCount) || n(usage.input_tokens);
+  let outTok =
+    n(usage.completion_tokens) ||
+    // 思考 token 也是输出的一部分（candidates 是正文）
+    n(usage.candidatesTokenCount) + n(usage.thoughtsTokenCount) ||
+    n(usage.output_tokens);
+  const cached =
+    n(usage.prompt_tokens_details?.cached_tokens) ||
+    n(usage.cachedContentTokenCount) ||
+    n(usage.cache_read_input_tokens);
+  return { in: inTok, out: outTok, cached };
 }
 
