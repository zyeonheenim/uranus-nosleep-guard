+/**
+ * 线下剧情的「气泡样式」（面板里那个「样式」弹窗）。
+ *
+ * 为什么搬到服务端：以前只存 localStorage，结果是**手机上改完，电脑上还是旧的**。
+ * localStorage 按「设备 + 浏览器 + 地址」隔离 —— 手机多半是 `http://192.168.x.x:8787`
+ * 打开、电脑是 `http://127.0.0.1:8787`，连源站都不是同一个，永远不会互相看见。
+ * 现在真值在这里（data/offline-bubbles.json），localStorage 只剩「打开瞬间先画出来」的缓存。
+ *
+ * 为什么不进 config.json：那边是「草稿 + 点保存」，一保存会把磁盘上的配置整包盖回去
+ * （老坑，踩过十几次）；气泡样式是「改一下就想立刻看到」的偏好，不该走那条路。
+ *
+ * 也不进云备份的「配置」：它不影响聊天内容，换机器重新调一次就行。
+ */
+
+import path from "node:path";
+
+import { DATA_DIR, readJson, writeJson } from "./datadir.js";
+
+const FILE = path.join(DATA_DIR, "offline-bubbles.json");
+
+/** 一份就这么点东西，正常不到 1 KB；给到 20 KB 是防着被塞奇怪的东西。 */
+const MAX_CHARS = 20_000;
+
+/** 和 offline.jsx:BUBBLE_SIDE_DEFAULTS 对齐。缺字段就用这里的，参数越界就夹回来。 */
+const SIDE_DEFAULTS = {
+  bg: "#ffffff",
+  bgAlpha: 100,
+  border: "#d8d8d8",
+  borderAlpha: 100,
+  borderWidth: 1,
+  text: "#3f3f3f",
+  radius: 12,
+};
